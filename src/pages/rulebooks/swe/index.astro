---
import Guide from '../../../layouts/Guide.astro';
import Lines from '../../../components/guide/Lines.astro';
import Manifest from '../../../components/guide/Manifest.astro';
import Tag from '../../../components/guide/Tag.astro';
import swe from '../../../data/swe.json';
import { BASE_RULES, HOOKS, plain } from '../../../data/swe-prose';
import { url } from '../../../lib/url';
import { STEPS } from '../../../data/lifecycle';

const { planThreshold, approvalGrade } = swe.numbers;
const sourceRoot = `https://github.com/${swe.source_repo}/blob/${swe.source_sha}/skills/kerby/`;
const page = (p: string) => url(`rulebooks/swe/${p}`);

// Blocking hooks: base's secret scan first (every rulebook has it), then swe's.
const blocking = [
  ...swe.base.hooks.map((h) => ({ ...h, base: true })),
  ...swe.hooks.map((h) => ({ ...h, base: false })),
].filter((h) => h.blocks);
const warning = swe.hooks.filter((h) => !h.blocks);

// How swe is built, for the "How swe works with kerby" section. Counts only.
const prose = swe.checks.filter((c) => c.kind === 'prose').length;
const code = swe.checks.filter((c) => c.kind === 'code').length;
const baseRules = swe.base.checks.filter((c) => c.kind === 'prose');

// Rules no hook can check — they live in the conversation, not at a tool call.
const INSTRUCTION_RULES = [
  'State a plan before the first edit',
  'Write the intent line before changing behavior',
  'Prove “done” with fresh evidence',
  'Run the right quality gate before commit',
  'Never print a secret into the chat',
  'Stay on the task; log other issues',
  'Never merge — merging is yours',
  'Keep non-production work away from production systems',
];
---

<Guide
  title="SWE overview"
  description="What kerby's swe rulebook does to a coding agent's work, what it blocks, what it costs, and how much of it a hook enforces.">
  <section aria-labelledby="top">
    <p class="eyebrow">SWE / the working agreement</p>
    <h1 id="top">Know what comes before “done”.</h1>
    <p class="lead">A visible plan. A reason for the change. Evidence you can inspect.</p>
    <p>
      swe is kerby’s rulebook for software engineering. It tells a coding agent — Claude Code or Codex —
      how to plan, change, check and report its work in your repo. Installed hooks check specific tool
      actions; most of the method is instructions the agent must follow.
    </p>

    <p><a href={page('bug-walkthrough/')}>Follow a settings bug from reproduction to verified result →</a></p>
  </section>

  <section aria-labelledby="does">
    <p class="eyebrow">Agent instruction</p>
    <h2 id="does">What changes in the agent’s work</h2>
    <div class="checkpoint">
      <h3>Completion needs evidence</h3>
      <dl class="facts">
        <dt>Condition</dt><dd>The claimed result has been checked.</dd>
        <dt>Evidence</dt><dd>Fresh output from the relevant checks, plus manual verification steps.</dd>
        <dt>If unmet</dt><dd>The agent must investigate the failure or report the limitation; it cannot support a success claim.</dd>
      </dl>
      <p class="small">This is an agent instruction, not an independent script that verifies every claim. <a href={page('hooks/#blind')}>See the enforcement limits.</a></p>
    </div>
    <p>Every rule serves one line, which swe calls its prime directive:</p>
    <blockquote>{plain('prime-directive')}</blockquote>
    <ul class="points">
      <li>
        <strong>The agent grades every task and picks a workflow.</strong> A typo and a new feature do not get
        the same process. <a href={page('workflows/')}>How tasks are routed</a>
      </li>
      <li>
        <strong>The agent states a plan before the first edit.</strong> From grade {planThreshold}, the plan is
        written in full. From grade {approvalGrade}, the agent stops and waits for your approval.
      </li>
      <li>
        <strong>The agent is instructed to work on a branch and commits after each finished piece.</strong> It never works on
        a protected branch such as main, and it never merges. Merging is yours.
      </li>
      <li>
        <strong>The agent must support “done” with fresh evidence.</strong> swe’s rule: “{plain('iron-law')}” The
        agent runs the checks and shows you the result, never “should work”.
      </li>
    </ul>
    <p class="small">Sources: <a href={`${sourceRoot}rulebooks/swe/BOOTSTRAP.md`}>SWE operating rules</a> and <a href={`${sourceRoot}rulebooks/swe/references/validation.md`}>verification before completion</a>.</p>
    <p><a href={page('lifecycle/')}>See all {STEPS.length} steps, from install to the final report</a></p>
  </section>

  <section aria-labelledby="map">
    <h2 id="map">Who is responsible for each boundary?</h2>
    <p><strong>Your decision:</strong> you approve work where the rules require it, review the result, and decide whether to merge. The agent supplies the evidence for that judgment.</p>
    <p>
      Most of swe is instructions: the agent follows them because it read them. Only the hooks can stop
      a matching action. Change the example configuration to compare responsibilities.
    </p>
    <div class="map">
      <p class="eyebrow">Example configuration</p>
      <p class="small">This is an illustration, not a reading of your installed setup. Run /kerby status in your agent to inspect that.</p>
      <label class="switch">
        <input type="checkbox" id="hooks-on" checked />
        Agent hooks installed in Claude Code
      </label>
      <div class="cols">
        <div class="col">
          <h3><Tag kind="hook" /></h3>
          <p class="when-on">Matching violations detected by installed hooks are blocked.</p>
          <p class="when-off">No agent-hook checks in this example configuration. A separately installed Git pre-commit hook may still run.</p>
          <ul class="when-on">
            {blocking.map((h) => <li>{HOOKS[h.script].name}</li>)}
          </ul>
        </div>
        <div class="col">
          <h3><Tag kind="instructions" /></h3>
          <p>The agent follows these because it read them.</p>
          <ul>
            {blocking.map((h) => <li class="when-off moved">{HOOKS[h.script].name}</li>)}
            {INSTRUCTION_RULES.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
      <p class="small">
        {warning.length} more hooks only warn and never stop anything:
        {' '}{warning.map((h) => HOOKS[h.script].name.toLowerCase()).join(', ')}.
      </p>
    </div>
  </section>

  <section aria-labelledby="blocks">
    <p class="eyebrow">Hook check</p>
    <h2 id="blocks">Specific actions can be blocked</h2>
    <p>
      When installed in a supported tool, these hooks inspect matching actions. A detected violation
      blocks that action and returns a reason. Each hook has limits; it does not evaluate the entire task.
    </p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Scrollable reference table">
      <table>
        <thead>
          <tr><th scope="col">Hook</th><th scope="col">It stops</th><th scope="col">Tier</th></tr>
        </thead>
        <tbody>
          {blocking.map((h) => (
            <tr>
              <td><span class="chip">{h.script}</span>{h.base && <span class="from"> from base</span>}</td>
              <td>{HOOKS[h.script].stops}</td>
              <td>{h.tier}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small">
      Hooks run only after you install them, and only in Claude Code. Codex reads the same rules but
      does not run the hooks. <a href={page('hooks/')}>Every hook, its gaps, and how to turn it off</a>
    </p>
  </section>

  <section aria-labelledby="fit">
    <h2 id="fit">Is it for you?</h2>
    <div class="fit">
      <div>
        <h3>A good fit if</h3>
        <ul>
          <li>you want to see the plan before the agent edits anything;</li>
          <li>you review the agent’s work as pull requests;</li>
          <li>you want proof that work is done, not a promise;</li>
          <li>you use Claude Code and want supported hook checks on destructive Git commands and staged secrets.</li>
        </ul>
      </div>
      <div>
        <h3>Not a fit if</h3>
        <ul>
          <li>you want an agent that edits quietly when asked;</li>
          <li>you want short answers without the extra lines;</li>
          <li>you need hard enforcement in a tool that does not run kerby’s hooks;</li>
          <li>you disagree with many rules and do not want to edit a rulebook.</li>
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="costs">
    <h2 id="costs">What it asks of you</h2>
    <div class="box">
      <h2 class="h-box">Read this before you adopt it</h2>
      <p>swe’s own README says this about itself:</p>
      <blockquote>“{plain('warning-opinionated')}”</blockquote>
      <p>
        The rules are one author’s taste, not a neutral default. They load into every session, so
        {' '}{plain('warning-token-cost')}. Read them, keep what fits your work, and change the rest. A
        rulebook is a folder you can fork.
      </p>
    </div>
    <p>Every change starts with these lines, even a one-word fix:</p>
    <Lines kind="format" ids={['format-complexity', 'format-rung', 'format-plan']} />
    <ul class="points">
      <li>
        <strong>Approval stops.</strong> Work graded {approvalGrade} or higher waits for your yes,
        including work that only reaches that grade halfway through.
      </li>
      <li>
        <strong>Many small commits.</strong> The agent commits after each finished piece. If your team
        wants one commit per change, squash when you merge.
      </li>
      <li>
        <strong>A plan even when you say “just do it”.</strong> Those words shorten the plan to one line.
        They do not remove it.
      </li>
      <li>
        <strong>Tokens.</strong> The rules load into every session.
      </li>
      <li>
        <strong>Enforcement depends on your tool.</strong> Hooks run in Claude Code. In Codex the rules are
        instructions only. On GitHub Copilot, kerby’s own docs say to treat it as advisory.
      </li>
    </ul>
  </section>

  <section aria-labelledby="engine">
    <h2 id="engine">Inside the rulebook</h2>
    <p class="small">Source: <a href={`${sourceRoot}SKILL.md`}>Kerby loading, trust, and installation contract</a>; <a href={`${sourceRoot}rulebooks/swe/rulebook.toml`}>SWE manifest</a>.</p>
    <p class="frame">
      <strong>swe is more than a prompt.</strong> It is a package that kerby runs. kerby loads its rules
      into your agent, installs its hooks in your agent tool, and runs its commands when you ask. One
      file, <code>rulebook.toml</code>, declares all of it.
    </p>

    <div class="flow">
      <div class="node">
        <h3>swe</h3>
        <p>a folder</p>
        <ul>
          <li>rulebook.toml</li>
          <li>{prose} prose checks in rule files</li>
          <li>{swe.hooks.length} hook scripts</li>
          <li>{swe.commands.length} commands</li>
        </ul>
      </div>
      <span class="link" aria-hidden="true"></span>
      <div class="node">
        <h3>kerby</h3>
        <p>the engine</p>
        <ul>
          <li>checks the manifest</li>
          <li>loads the rules</li>
          <li>installs the hooks</li>
          <li>runs the commands</li>
        </ul>
      </div>
      <span class="link" aria-hidden="true"></span>
      <div class="node">
        <h3>your agent</h3>
        <p>Claude Code or Codex</p>
        <ul>
          <li>reads the rules as instructions</li>
          <li>can be stopped by a configured hook</li>
          <li>follows a command when you run it</li>
        </ul>
      </div>
    </div>
    <p class="small">
      Under every rulebook, kerby also adds <strong>base</strong>: {baseRules.length} floor rules and the
      secret scan. No rulebook can turn them off.
    </p>

    <h3 class="inside-h">Look inside swe</h3>
    <div class="picker" data-picker="Parts of swe">
      <div class="choice" data-choice data-label="rulebook.toml" id="part-manifest">
        <h4>rulebook.toml — the manifest</h4>
        <p>
          kerby reads this file first, every time. It lists all {swe.checks.length} checks — {prose} prose
          and {code} code — and the {swe.commands.length} commands. For each check it says what kind it is,
          how it is enforced, and which script runs it. If the file is invalid, kerby loads nothing.
        </p>
        <Manifest
          id="toml-destructive-git"
          caption="one check, as kerby reads it"
          notes={[
            { key: 'kind = "code"', note: 'Backed by a script, not only by text.' },
            { key: 'enforcer =', note: 'The script that /kerby install registers in your agent tool.' },
            { key: 'event =', note: 'The script runs before the tool call happens…' },
            { key: 'matcher =', note: '…but only for shell commands.' },
            { key: 'severity =', note: 'A failed check stops the action. It does not only warn.' },
            { key: 'floor = true', note: 'No rulebook or setting can loosen it, so install never offers this hook for skipping on its own.' },
          ]}
        />
      </div>

      <div class="choice" data-choice data-label="Rule files" id="part-rules">
        <h4>Rule files — what the agent reads <Tag kind="instructions" /></h4>
        <p>
          The {prose} prose checks point to Markdown files: BOOTSTRAP.md and its references. At load,
          kerby reads BOOTSTRAP.md and the short rules into the agent’s context in full. Longer references
          are read only when a step needs them. No script checks that the agent follows them.
        </p>
        <Manifest
          id="toml-intent-gate"
          notes={[
            { key: 'kind = "prose"', note: 'Text the agent reads. No script checks it.' },
            { key: 'body =', note: 'The file kerby reads into the agent’s context.' },
            { key: 'enforcement =', note: 'Instructions only: the agent follows it because it read it.' },
            { key: 'token_cost = "low"', note: 'Short, so it loads at every session start, not only when a step needs it.' },
          ]}
        />
      </div>

      <div class="choice" data-choice data-label="hooks/" id="part-hooks">
        <h4>hooks/ — what can stop an action <Tag kind="hook" /></h4>
        <p>
          {swe.hooks.length} shell scripts. /kerby install registers them in your agent tool’s settings,
          after you agree. From then on, the tool runs them before a matching tool call, and a script can
          stop that call. Claude Code runs them. Codex does not.
        </p>
        <ul class="parts">
          {swe.hooks.map((h) => <li><span class="chip">{h.script}</span> {HOOKS[h.script].name} · {h.tier}</li>)}
        </ul>
        <p><a href={page('hooks/')}>What each hook stops, and what it misses</a></p>
      </div>

      <div class="choice" data-choice data-label="commands/" id="part-commands">
        <h4>commands/ — what you run</h4>
        <p>
          {swe.commands.length} command files. When you type a command, kerby reads its file and the agent
          follows it.
        </p>
        <Manifest
          id="toml-audit"
          notes={[
            { key: 'name =', note: 'You run it as /kerby swe audit.' },
            { key: 'body =', note: 'The file kerby reads and follows when you run it.' },
          ]}
        />
      </div>

      <div class="choice" data-choice data-label="base (from kerby)" id="part-base">
        <h4>base — the floor under swe</h4>
        <p>
          base is not part of swe. kerby adds it under every rulebook, so swe always has it. It brings the
          secret-scan hook and {baseRules.length} rules that no rulebook can turn off:
        </p>
        <ul class="parts">
          {baseRules.map((c) => <li>{BASE_RULES[c.id]}</li>)}
        </ul>
      </div>
    </div>

    <div class="box gate">
      <h3>kerby is a gate, not a prompt file</h3>
      <ul>
        <li>It picks the rulebook from your lock file or your repo’s files, and asks you when it cannot tell. It never picks silently.</li>
        <li>
          Before it loads a rulebook that did not ship with kerby, it shows what the rulebook will do and asks
          “{plain('trust-prompt')}” It asks again whenever that rulebook’s files change.
        </li>
        <li>
          If a rulebook cannot load — an invalid manifest, a missing file — kerby loads nothing and marks the
          work HELD for you to decide. A failed load never counts as a pass.
        </li>
        <li>After a compaction, kerby’s session hook puts the rules back, in Claude Code, if you installed it.</li>
      </ul>
    </div>
  </section>

  <section aria-labelledby="more">
    <h2 id="more">Read next</h2>
    <ul class="next">
      <li><a href={page('bug-walkthrough/')}><strong>Bug walkthrough</strong><span>One task, its conditions, and the evidence needed to finish.</span></a></li>
      <li><a href={page('lifecycle/')}><strong>Lifecycle</strong><span>What swe does at each of {STEPS.length} steps, from install to the final report.</span></a></li>
      <li><a href={page('workflows/')}><strong>Workflows</strong><span>The {swe.routes.length} routes, the 1–{swe.numbers.maxGrade} grade, and what happens to your kind of task.</span></a></li>
      <li><a href={page('hooks/')}><strong>Hooks</strong><span>Each hook: what it stops, what it misses, and how to turn it off.</span></a></li>
      <li><a href={page('reference/')}><strong>Reference</strong><span>Commands, the files swe keeps, and a glossary.</span></a></li>
    </ul>
  </section>
</Guide>

<style>
  .h-box {
    font-size: 1.15rem;
  }

  .frame {
    font-size: 1.1rem;
  }

  /* swe → kerby → agent. The connector is a 1px structure line, not a glyph. */
  .flow {
    display: grid;
    grid-template-columns: 1fr 1.25rem 1fr 1.25rem 1fr;
    align-items: stretch;
    margin: 1.5rem 0 0.75rem;
  }

  .flow .node {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    padding: 0.9rem 1rem;
  }

  .flow .node:nth-of-type(2) {
    border-color: var(--structure);
  }

  .flow h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .flow .node > p {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .flow ul {
    margin: 0;
    padding-left: 1rem;
    font-size: 0.92rem;
    display: grid;
    gap: 0.2rem;
  }

  .flow .link {
    align-self: center;
    border-top: 1px solid var(--structure);
  }

  @media (max-width: 640px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1rem auto 1rem auto;
    }

    .flow .link {
      justify-self: center;
      align-self: stretch;
      border-top: 0;
      border-left: 1px solid var(--structure);
    }
  }

  .inside-h {
    margin-top: 2rem;
  }

  .picker h4 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
  }

  .parts {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
  }

  .gate ul {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
  }

  .gate h3 {
    margin-top: 0;
  }

  .from {
    font-size: 0.85rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .points {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.75rem;
  }

  .fit {
    display: grid;
    gap: 0.5rem 2rem;
  }

  @media (min-width: 640px) {
    .fit {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fit h3 {
    margin-top: 0;
  }

  .fit ul {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }
</style>
