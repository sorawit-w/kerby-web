---
import Guide from '../../../layouts/Guide.astro';
import Command from '../../../components/guide/Command.astro';
import Lines from '../../../components/guide/Lines.astro';
import Tag from '../../../components/guide/Tag.astro';
import { LANES, STEPS } from '../../../data/lifecycle';
import swe from '../../../data/swe.json';
import { url } from '../../../lib/url';

const sourceRoot = `https://github.com/${swe.source_repo}/blob/${swe.source_sha}/skills/kerby/`;
const sourceFiles = (source: string) => {
  const paths = source.includes('kerby') ? ['SKILL.md'] : [];
  if (source.includes('BOOTSTRAP')) paths.push('rulebooks/swe/BOOTSTRAP.md');
  for (const file of ['references/intent-gate.md', 'references/quality-gates.md', 'workflows/feature.md']) {
    if (source.includes(file)) paths.push(`rulebooks/swe/${file}`);
  }
  return paths;
};

// Phases in step order, each with the step numbers it holds — for the nav.
const PHASES = STEPS.reduce<{ name: string; steps: number[] }[]>((acc, step, i) => {
  const last = acc[acc.length - 1];
  if (last && last.name === step.phase) last.steps.push(i + 1);
  else acc.push({ name: step.phase, steps: [i + 1] });
  return acc;
}, []);
---

<Guide
  title="Lifecycle"
  description={`What kerby's swe rulebook does at each of ${STEPS.length} steps of a coding agent's work, from install to the final report.`}>
  <section aria-labelledby="top">
    <p class="eyebrow">SWE / conditions for progress</p>
    <h1 id="top">Progress has checkpoints.</h1>
    <p class="lead">See what must be established before the agent advances, and where it returns when a check fails.</p>
    <p>
      The {STEPS.length} detailed steps below include setup and the working lifecycle. They are not a
      promise of one straight pass: investigation, changes, and checks repeat as needed. The
      <a href={url('rulebooks/swe/bug-walkthrough/')}>six-stage bug walkthrough</a> is a simplified reading of this method.
    </p>

    <div class="checkpoint">
      <h2>Setup once. Load each session. Work in loops.</h2>
      <p>Installation establishes the configuration; loading and reading the project establish session context. Task execution then moves through Decide, Build, and Finish.</p>
      <p class="state">If a check fails → return to investigation.</p>
      <p>Understand the cause, make a focused change, and rerun the relevant check. Do not treat a warning, a completed edit, or a successful commit as proof that the intended behavior works.</p>
      <p class="small">These are editorial summaries of the source rules below, not literal Kerby output.</p>
    </div>
    <h2 class="steps-h" id="who">Who acts at each step</h2>
    <p>
      swe is not only rules for the agent. kerby itself acts at some steps, hooks act at others, and some
      decisions are yours. A filled dot means that part acts in the step. A ring means it acts only
      sometimes.
    </p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Scrollable reference table">
      <table class="swim">
        <caption class="visually-hidden">Who acts in each of the {STEPS.length} steps</caption>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Who</span></th>
            {STEPS.map((step, i) => (
              <th scope="col"><a href={`#step-${i + 1}`} title={step.title}><span class="visually-hidden">Step </span>{i + 1}<span class="visually-hidden">: {step.title}</span></a></th>
            ))}
          </tr>
        </thead>
        <tbody>
          {LANES.map((lane) => (
            <tr class={`lane-${lane.id}`}>
              <th scope="row">{lane.name}</th>
              {STEPS.map((step) => {
                const v = step.lanes[lane.id];
                return (
                  <td>
                    {v && (
                      <span class={`mark ${v}`}>
                        <span class="visually-hidden">{v === 'always' ? 'acts' : 'sometimes acts'}</span>
                      </span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="swim-notes small">
      <li><strong>kerby</strong> acts when you install it, at every session start, and after a compaction if its session hook is installed.</li>
      <li><strong>Hooks</strong> run only where installed and supported, on matching tool calls. Recognized destructive Git commands can be blocked at any step; see <a href={url('rulebooks/swe/hooks/')}>each hook’s coverage and gaps</a>.</li>
      <li><strong>You</strong> run install, approve a plan graded {swe.numbers.approvalGrade} or higher, and review and merge the work.</li>
    </ul>

    <h2 class="steps-h">The {STEPS.length} steps</h2>
    <div class="stepper">
      <nav class="stepnav" aria-label="Steps" data-stepnav>
        {PHASES.map((phase) => (
          <div class="group">
            <span class="group-name">{phase.name}</span>
            <ol class="nums">
              {phase.steps.map((n) => (
                <li>
                  <a href={`#step-${n}`} title={STEPS[n - 1].title}>
                    <span class="visually-hidden">Step </span>{n}<span class="visually-hidden">: {STEPS[n - 1].title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </nav>
      <ol class="steps">
        {STEPS.map((s, i) => (
          <li class="step" data-step id={`step-${i + 1}`}>
            <h3>
              <span class="num">{i + 1}</span>
              {s.title}
              {s.tag && <Tag kind={s.tag} />}
            </h3>
            <p class="phase">{s.phase}</p>
            {s.body.map((p) => <p>{p}</p>)}
            <dl class="checkpoint facts">
              <dt>Condition</dt><dd>{s.condition}</dd>
              <dt>Evidence</dt><dd>{s.evidence}</dd>
              <dt>If unmet</dt><dd>{s.ifUnmet}</dd>
            </dl>
            {s.commands?.map((c) => <Command title={c.title} ids={c.ids} />)}
            {s.lines && <Lines kind="format" ids={s.lines} caption={s.caption} />}
            <p class="small">Source: {s.source}. {sourceFiles(s.source).map((file) => <a class="source-file" href={`${sourceRoot}${file}`}>{file.split('/').pop()}</a>)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="next-h">
    <h2 id="next-h">Read next</h2>
    <ul class="next">
      <li><a href={url('rulebooks/swe/bug-walkthrough/')}><strong>Bug walkthrough</strong><span>Watch these conditions shape one complete illustrative task.</span></a></li>
      <li><a href={url('rulebooks/swe/workflows/')}><strong>Workflows</strong><span>Which route your kind of task takes, and the 1–{swe.numbers.maxGrade} grade.</span></a></li>
      <li><a href={url('rulebooks/swe/hooks/')}><strong>Hooks</strong><span>The steps a hook checks, in detail.</span></a></li>
    </ul>
  </section>
</Guide>

<style>
  /* Keep dividers separate from the headings and labels that follow them. */
  .checkpoint {
    margin-block: 2rem;
    padding-top: 1.5rem;
  }

  .stepper .step {
    padding-block: 2.5rem;
  }

  .source-file { margin-inline-start: 0.5rem; }
  .steps-h {
    margin-top: 2rem;
  }

  /* Swimlane: a real table, so screen readers get rows and columns for free. */
  .swim {
    table-layout: fixed;
    min-width: 34rem;
  }

  .swim th:first-child {
    width: 9.5rem;
  }

  .swim thead th {
    text-align: center;
    padding: 0 0 0.5rem;
  }

  .swim thead th:first-child {
    text-align: left;
  }

  .swim thead a {
    color: var(--secondary);
    text-decoration: none;
  }

  .swim thead a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .swim tbody th {
    text-align: left;
    font-family: var(--font-body);
    letter-spacing: 0;
    color: var(--text);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.55rem 0.5rem 0.55rem 0;
    border-bottom: 1px solid var(--border);
  }

  .swim td {
    text-align: center;
    vertical-align: middle;
    padding: 0.55rem 0;
  }

  .swim .mark {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    vertical-align: middle;
  }

  .swim .mark.always {
    background: var(--secondary);
  }

  .swim .mark.sometimes {
    border: 1.5px solid var(--secondary);
  }

  /* Participation uses structure color; state is always described in text. */
  .swim .lane-hooks .mark.always {
    background: var(--structure);
  }

  .swim-notes {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.3rem;
  }
</style>
