---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Journey from '../components/Journey.astro';
import Demo from '../components/Demo.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
---
<Base title="kerby — the gate guardian for agentic work" description="Set conditions for agentic work and evidence for completion. Kerby combines rulebook instructions with installed checks; SWE is its software-engineering rulebook.">
  <SiteHeader />
  <main id="main"><Hero /><Demo /><Journey /><Install /></main>
  <Footer />
</Base>
<script src="../scripts/guide.js"></script>

<style>
  main :global(> section) { max-width:64rem; }
</style>
