---
const LINKS = [
  ['GitHub', 'https://github.com/sorawit-w/kerby'],
  ['Changelog', 'https://github.com/sorawit-w/kerby/blob/main/CHANGELOG.md'],
  ['MIT', 'https://github.com/sorawit-w/kerby-web/blob/main/LICENSE'],
  ['sorawit.com', 'https://sorawit.com'],
] as const;
---

<footer class="section site-footer" aria-label="Site footer">
  <div class="footer-row">
    <p class="identity"><strong>kerby</strong><span>Rulebooks for agentic work. Conditions before completion.</span></p>
    <nav aria-label="Footer links"><ul class="links">
      {LINKS.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
    </ul></nav>
  </div>
  <p class="note">Not affiliated with Apache Kerby, the Apache Directory Kerberos library.</p>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 2rem;
  }
  .footer-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }
  .identity { margin: 0; max-width: 32rem; }
  .identity strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
    margin-bottom: .5rem;
  }
  .identity span, .note { color: var(--muted); font-size: .85rem; }
  .links {
    display: flex;
    gap: .75rem 1.5rem;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: .9rem;
  }
  .note { margin: 1.5rem 0 0; max-width: none; }
  @media (max-width: 959px) {
    .footer-row { flex-direction: column; gap: 1.5rem; }
  }
</style>
