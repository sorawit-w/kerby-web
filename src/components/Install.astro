---
// Install — literal zone: no persona, no wit (VOICE.md zoning).
// Commands come from guide/Command.astro: one row per command, each read from
// kerby's README (check:swe), with a Copy button where the clipboard exists.
import Command from './guide/Command.astro';

const README = 'https://github.com/sorawit-w/kerby#readme';
---

<section id="install" aria-labelledby="install-heading">
  <h2 id="install-heading">Install</h2>

  <Command ids={['install-marketplace', 'install-plugin']} />

  <p>Or via the cross-platform CLI:</p>

  <Command ids={['install-cli']} />

  <p>
    Then: <code>/kerby</code> loads the rules into the session. <code>/kerby status</code> checks
    they're still active.
  </p>

  <p><a href={README}>Full documentation <span class="arrow" aria-hidden="true">→</span></a></p>
</section>

<style>
  code {
    font-family: var(--font-mono);
  }
</style>
