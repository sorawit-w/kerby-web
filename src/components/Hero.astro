---
import { url } from '../lib/url';
import { SCENARIO, CHECKPOINTS } from '../data/bug-walkthrough';
const preview = [CHECKPOINTS[0], CHECKPOINTS[1], CHECKPOINTS[4]];
const descriptions = ['Save a setting, refresh, and observe the reset.', 'Trace where the saved value is lost.', 'Repeat the same steps after the fix.'];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">KERBY / SWE RULEBOOK</p>
    <h1 id="hero-title">See how your <br />agent gets to done.</h1>
    <p class="lead">A guarded path through investigating, planning, changing, and verifying your code.</p>
    <div class="ctas"><a class="cta" href={url('rulebooks/swe/bug-walkthrough/')}>Follow a bug fix <span class="direction-arrow" aria-hidden="true">→</span></a><a class="secondary-link" href={url('rulebooks/swe/')}>Explore SWE</a></div>
    <p class="judgment">For coding agents. Built around your judgment.</p>
  </div>
  <aside class="story" aria-label="Illustrative settings bug">
    <p class="eyebrow">ILLUSTRATIVE EXAMPLE</p>
    <blockquote>“{SCENARIO}”</blockquote>
    <ol>{preview.map((step, i) => <li><span class="number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><a href={url(`rulebooks/swe/bug-walkthrough/#${step.id}`)}>{i === 0 ? 'Reproduce' : step.stage}</a><p>{descriptions[i]}</p></div></li>)}</ol>
  </aside>
</section>
<style>
.hero { display:grid; grid-template-columns:1.15fr 1fr; gap:3rem; padding-block:3.5rem; }
h1 { margin:0 0 1.5rem; font-size:clamp(2.5rem,4.7vw,4.25rem); line-height:1.03; letter-spacing:-.055em; }
.lead { max-width:30rem; font-size:1.4rem; line-height:1.45; margin:0; }
.ctas { margin:1.75rem 0; }
.secondary-link { color:var(--text); }
.judgment { color:var(--muted); font-size:.9rem; margin:0; }
.story { border-left:1px solid var(--border); padding-left:3rem; }
blockquote { margin:0 0 1.75rem; font-family:Georgia,serif; font-size:clamp(1.7rem,2.5vw,2.25rem); line-height:1.2; letter-spacing:-.035em; }
ol { list-style:none; margin:0; padding:0; }
li { display:flex; gap:1.5rem; position:relative; padding-bottom:1.8rem; }
li:last-child { padding-bottom:0; }
li:not(:last-child)::before { content:''; position:absolute; left:1.2rem; top:2.4rem; bottom:0; border-left:1px solid var(--border); }
.number { display:grid; place-items:center; flex:none; width:2.4rem; height:2.4rem; border:1px solid var(--border); border-radius:50%; font-size:.75rem; font-family:var(--font-mono); }
li a { color:var(--text); text-decoration:none; font-weight:500; }
li a:hover { text-decoration:underline; }
li p { margin:.25rem 0 0; color:var(--muted); font-size:.9rem; }
@media(max-width:959px) { .hero { grid-template-columns:1fr; gap:2rem; } h1 br { display:none; } .hero-copy { max-width:40rem; } .story { border-left:0; border-top:1px solid var(--border); padding:2rem 0 0; } }
</style>
