---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import portrait from '../assets/kerby-hero.png';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">WORKS WITH CLAUDE CODE AND CODEX</p>
    <h1 id="hero-title">The gate guardian for agentic work.</h1>
    <p class="lead">Conditions before action. Evidence before “done.”</p>
    <p class="explanation">Kerby brings rules and checks to your agent’s work. Rulebooks define the conditions; installed hooks enforce specific actions.</p>
    <div class="ctas"><a class="cta" href={url('#install')}>Install Kerby <span class="direction-arrow" aria-hidden="true">→</span></a><a class="secondary-link" href={url('#demo')}>See it in action ↓</a></div>
  </div>
  <Image class="portrait" src={portrait} width={180} height={180} densities={[1,2]} format="webp" alt="Kerby, the pixel-art gate guardian" />
</section>
<style>
.hero { display:grid; grid-template-columns:minmax(0,1fr) 180px; align-items:center; gap:4rem; padding-block:3rem; }
h1 { max-width:44rem; margin:0 0 1.25rem; font-size:clamp(2.5rem,4.7vw,4.25rem); line-height:1.03; letter-spacing:-.055em; }
.lead { font-size:1.4rem; margin:0 0 .75rem; }
.explanation { max-width:38rem; color:var(--secondary); margin:0; }
.ctas { margin:1.5rem 0 0; }
.secondary-link { color:var(--text); }
.portrait { image-rendering:pixelated; }
@media(max-width:600px) { .hero { grid-template-columns:1fr; gap:1.5rem; } .portrait { grid-row:1; width:96px; height:96px; } .eyebrow { font-size:.65rem; } }
</style>
