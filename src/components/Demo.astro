---
import ConsoleText from './ConsoleText.astro';
import swe from '../data/swe.json';
const TRANSCRIPTS = [
  `BLOCKED: git push --force / -f
Reason: destructive git command — data loss is hard or impossible to undo.
If you really need this, run it yourself in a terminal.
See kerby guardrails (hooks/protect-git.sh).`,
  `BLOCKED: '.env' already exists — replacing it would overwrite its current contents.
Env files are the one class git cannot restore — a real .env is gitignored, so an
overwrite has no undo. Hand the required variables to the user to add themselves:
  <VAR>=<value>
Placeholders belong in .env.example / .env.template / .env.sample — a regular file,
named absolutely, which is neither a symlink nor a hard link to another file.
See kerby guardrails (references/guardrails.md § Environment Files).`,
  `WARNING: gitleaks detected possible secrets in staged changes.
Output suppressed so the secret isn't echoed here — inspect locally with
'gitleaks stdin --redact', or allowlist a false positive in the scanner's config.`,
];

const labels = ['Destructive Git command', 'Existing environment file', 'Possible staged secret'];
const outcomes = ['Blocked — destructive command stopped.', 'Blocked — overwrite stopped.', 'Blocked — despite the WARNING prefix, a secret finding stops the commit.'];
const ids = ['force-push', 'env-overwrite', 'secret-scan'];
---
<section id="demo" aria-labelledby="demo-heading">
  <p class="eyebrow">HOOK CHECKS IN PRACTICE</p>
  <h2 id="demo-heading">A boundary you can inspect.</h2>
  <p>These genuine transcripts show specific checks. They do not establish that every instruction is enforced, or that every warning blocks an action.</p>
  <div class="transcript-list">{TRANSCRIPTS.map((text, i) => <details open={i === 0}><summary>{labels[i]}</summary><p>{outcomes[i]}</p><button class="replay" hidden type="button">Replay output</button><pre tabindex="0" aria-label={`${labels[i]} transcript`} data-transcript={ids[i]}><ConsoleText text={text} /></pre></details>)}</div>
  <p class="source-note"><a href={`https://github.com/${swe.source_repo}/blob/${swe.source_sha}/README.md#what-it-looks-like-when-kerby-says-no`}>Read the original transcripts ↗</a> · Exact text from the pinned Kerby release.</p>
</section>
<style>
section { border-top:1px solid var(--border); } h2 { margin:0 0 1rem; }
.transcript-list { margin-top:2rem; }
details { border-top:1px solid var(--structure); padding:1rem 0; }
summary { cursor:pointer; font-weight:500; padding:.25rem 0; }
pre { background:var(--panel-bg); color:var(--panel-text); padding:1.5rem; border-radius:6px; overflow:auto; font-size:.82rem; line-height:1.65; }
.source-note { font-size:.85rem; color:var(--muted); }
</style>

<script>import '../scripts/verdicts.js';</script>
<style>
.replay { margin-bottom: .5rem; }
pre :global(.reveal-word) { transition: opacity 80ms linear; }
@media (prefers-reduced-motion: reduce) { pre :global(.reveal-word) { transition: none; } }
</style>
