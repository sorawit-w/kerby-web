---
// Commands a reader pastes into their agent, one per row, each read from an
// anchored line in kerby's READMEs (check:swe fails if one changes upstream).
// One row per command, never a multi-line block: pasting two slash commands
// as one message would not run both. Styled like the landing install block —
// light surface, because these are the reader's input, not kerby's output.
// The script below adds a Copy button to each row when the clipboard API
// exists; without it the command is plain, selectable text. Astro renders it
// once per page, however many Command blocks the page has.
import { command } from '../../data/swe-prose';

interface Props {
  ids: string[];
  title?: string;
}
const { ids, title } = Astro.props;
---

<div class="command">
  {title && <p class="command-title">{title}</p>}
  <ul>
    {ids.map((id) => (
      <li data-copy-row>
        <code>{command(id)}</code>
      </li>
    ))}
  </ul>
</div>

<script>
  function el(tag: string, attrs: Record<string, string> = {}, text?: string) {
    const node = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
    if (text != null) node.textContent = text;
    return node;
  }

  // Copy buttons for command rows. Only where the clipboard API exists;
  // otherwise the command stays plain, selectable text.
  function copyRows(rows: Element[]) {
    if (!rows.length || !window.isSecureContext || !navigator.clipboard?.writeText) return;
    const live = el('p', { class: 'visually-hidden', 'aria-live': 'polite' });
    document.body.append(live);
    rows.forEach((row) => {
      const code = row.querySelector('code')!;
      const text = code.textContent!.trim();
      const button = el('button', { type: 'button', class: 'copy', 'aria-label': `Copy ${text}` });
      const label = el('span', { class: 'copy-label' }, 'Copy');
      button.append(el('span', { class: 'copy-mark', 'aria-hidden': 'true' }, '✓'), label);
      let timer: ReturnType<typeof setTimeout>;
      button.addEventListener('click', async (event) => {
        clearTimeout(timer);
        button.removeAttribute('data-copied');
        // A keyboard press (detail 0) shows the mark at once, without the fade.
        button.toggleAttribute('data-instant', event.detail === 0);
        try {
          await navigator.clipboard.writeText(text);
          label.textContent = 'Copied';
          button.setAttribute('data-copied', '');
          live.textContent = `Copied ${text}`;
        } catch {
          // Clipboard refused: select the command so the reader can copy it by hand.
          window.getSelection()!.selectAllChildren(code);
          label.textContent = 'Selected';
          live.textContent = `${text} is selected. Copy it with your keyboard.`;
        }
        timer = setTimeout(() => {
          label.textContent = 'Copy';
          button.removeAttribute('data-copied');
          live.textContent = '';
        }, 1600);
      });
      row.append(button);
    });
  }

  copyRows([...document.querySelectorAll('[data-copy-row]')]);
</script>

<style>
  .command {
    margin: 1rem 0;
  }

  .command-title {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    color: var(--secondary);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.6rem 0.55rem 1.1rem;
    max-width: none;
  }

  li + li {
    border-top: 1px solid var(--border);
  }

  /* .command raises this above guide.css's inline-code rule (.guide :not(pre) > code). */
  .command code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: pre;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text);
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0.25rem 0;
  }

  li :global(.copy) {
    flex: none;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--secondary);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
  }

  li :global(.copy:hover) {
    color: var(--text);
    border-color: var(--structure);
  }

  li :global(.copy[data-copied]) {
    color: var(--text);
    border-color: var(--accent);
  }

  /* The checkmark takes no space at rest, so the button keeps today's width. */
  li :global(.copy-mark) {
    display: none;
    margin-right: 0.35rem;
  }

  li :global(.copy[data-copied] .copy-mark) {
    display: inline;
  }

  @media (prefers-reduced-motion: no-preference) {
    li :global(.copy[data-copied]:not([data-instant]) .copy-mark) {
      animation: copy-mark var(--motion-feedback) linear;
    }
  }

  @keyframes copy-mark {
    from {
      opacity: 0;
    }
  }
</style>
