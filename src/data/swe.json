    {
      "id": "format-smallest",
      "file": "skills/kerby/rulebooks/swe/workflows/feature.md",
      "quote": "smallest: <the least you can build that fully satisfies the request>"
    },
    {
      "id": "format-deferring",
      "file": "skills/kerby/rulebooks/swe/workflows/feature.md",
      "quote": "deferring: <items, comma-separated> | none"
    },
    {
      "id": "format-worktree",
      "file": "skills/kerby/rulebooks/swe/BOOTSTRAP.md",
