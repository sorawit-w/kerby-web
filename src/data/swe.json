{
  "source_repo": "sorawit-w/kerby",
  "source_sha": "3c750e205dda90fc242c6063a1323ce8ff94bc29",
  "version": "2.13.2",
  "kerby_version": "10.2.2",
  "description": "Coding guardrails: clarity over cleverness, safety over speed, never leave the repo broken — nothing unproven passes the gate.",
  "numbers": {
    "planThreshold": 4,
    "approvalGrade": 7,
    "recentCommits": 20,
    "costlyNewFiles": 3,
    "costlyEditedFiles": 5,
    "maxGrade": 10
  },
  "routes": [
    "investigate",
    "new-project",
    "adopt-existing",
    "feature",
    "bugfix",
    "quick-task"
  ],
  "checks": [
    {
      "id": "operating-rules",
      "kind": "prose",
      "body": "BOOTSTRAP.md",
      "enforcement": "behavioral",
      "severity": "block",
      "token_cost": "medium"
    },
    {
      "id": "quality-gate-tiers",
      "kind": "prose",
      "body": "references/quality-gates.md",
      "enforcement": "behavioral",
      "severity": "block",
      "token_cost": "medium"
    },
    {
      "id": "verification-before-completion",
      "kind": "prose",
      "body": "references/validation.md",
      "enforcement": "behavioral",
      "severity": "block",
      "token_cost": "high"
    },
    {
      "id": "security-lens",
      "kind": "prose",
      "body": "references/validation.md",
      "enforcement": "behavioral",
      "severity": "block",
      "token_cost": "high"
    },
    {
      "id": "guardrails-scope-security",
      "kind": "prose",
      "body": "references/guardrails.md",
      "enforcement": "behavioral",
      "severity": "block",
      "token_cost": "high"
    },
    {
      "id": "intent-gate-on-behavior-change",
      "kind": "prose",
      "body": "references/intent-gate.md",
      "enforcement": "behavioral",
      "severity": "block",
      "token_cost": "low"
    },
    {
      "id": "destructive-git",
      "kind": "code",
      "needs": [
        "branch"
      ],
      "enforcement": "hard",
      "enforcer": "hooks/protect-git.sh",
      "event": "PreToolUse",
      "matcher": "Bash",
      "severity": "block",
      "floor": true
    },
    {
      "id": "protected-branch-commit",
      "kind": "code",
      "needs": [
        "branch",
        "install_state"
      ],
      "enforcement": "hard",
      "enforcer": "hooks/protect-git.sh",
      "event": "PreToolUse",
      "matcher": "Bash",
      "severity": "block",
      "override": "authorized-scoped"
    },
    {
      "id": "protect-env",
      "kind": "code",
      "needs": [
        "changed_files"
      ],
      "enforcement": "hard",
      "enforcer": "hooks/protect-env.sh",
      "event": "PreToolUse",
      "matcher": "Edit|Write",
      "severity": "block"
    },
    {
      "id": "env-read-warning",
      "kind": "code",
      "needs": [
        "changed_files"
      ],
      "enforcement": "partial",
      "enforcer": "hooks/warn-env-read.sh",
      "event": "PreToolUse",
      "matcher": "Read",
      "gap": "Bash cat .env not caught; Read-tool only",
      "severity": "warn"
    },
    {
      "id": "high-stakes-routing",
      "kind": "code",
      "needs": [
        "changed_files"
      ],
      "enforcement": "partial",
      "enforcer": "hooks/route-high-stakes.sh",
      "event": "PreToolUse",
      "matcher": "Edit|Write",
      "gap": "prose-only production-traffic-shaping category un-globbable",
      "severity": "warn"
    },
    {
      "id": "hollow-test-heuristic",
      "kind": "code",
      "needs": [
        "added_lines"
      ],
      "enforcement": "partial",
      "enforcer": "hooks/hollow-test-check.sh",
      "event": "PreToolUse",
      "matcher": "Bash",
      "gap": "runtime fakes (0-match runs, gates over stubs) stay agent-judged",
      "severity": "warn"
    },
    {
      "id": "status-provenance",
      "kind": "code",
      "needs": [
        "staged_content"
      ],
      "enforcement": "partial",
      "enforcer": "hooks/status-provenance-check.sh",
      "event": "PreToolUse",
      "matcher": "Bash",
      "gap": "fails open, visibly, when the guard script is missing; `git commit` reached through `git -C` or `cd … &&` is not recognised",
      "severity": "block"
    }
  ],
  "hooks": [
    {
      "script": "protect-git.sh",
      "enforcer": "hooks/protect-git.sh",
      "event": "PreToolUse",
      "matcher": "Bash",
      "tier": "locked",
      "blocks": true,
      "checks": [
        "destructive-git",
        "protected-branch-commit"
      ]
    },
    {
      "script": "protect-env.sh",
      "enforcer": "hooks/protect-env.sh",
      "event": "PreToolUse",
      "matcher": "Edit|Write",
      "tier": "recommended",
      "blocks": true,
      "checks": [
        "protect-env"
      ]
    },
    {
      "script": "warn-env-read.sh",
      "enforcer": "hooks/warn-env-read.sh",
      "event": "PreToolUse",
      "matcher": "Read",
      "tier": "optional",
      "blocks": false,
      "checks": [
        "env-read-warning"
      ]
    },
    {
      "script": "route-high-stakes.sh",
      "enforcer": "hooks/route-high-stakes.sh",
      "event": "PreToolUse",
      "matcher": "Edit|Write",
      "tier": "optional",
      "blocks": false,
      "checks": [
        "high-stakes-routing"
      ]
    },
    {
      "script": "hollow-test-check.sh",
      "enforcer": "hooks/hollow-test-check.sh",
      "event": "PreToolUse",
      "matcher": "Bash",
      "tier": "optional",
      "blocks": false,
      "checks": [
        "hollow-test-heuristic"
      ]
    },
    {
      "script": "status-provenance-check.sh",
      "enforcer": "hooks/status-provenance-check.sh",
      "event": "PreToolUse",
      "matcher": "Bash",
      "tier": "recommended",
      "blocks": true,
      "checks": [
        "status-provenance"
      ]
    }
  ],
  "commands": [
    {
      "name": "audit",
      "body": "commands/audit.md",
      "description": "Static conformance audit of the project against the loaded corpus; writes a report under .kerby/audits/."
    },
    {
      "name": "prepare",
      "body": "commands/prepare.md",
      "description": "Onboard an existing repo: populate kerby's context artifacts from code and git history, diff-and-confirm on every write."
    }
  ],
  "base": {
    "version": "1.3.0",
    "hooks": [
      {
        "script": "pre-commit-check.sh",
        "enforcer": "hooks/pre-commit-check.sh",
        "event": "PreToolUse",
        "matcher": "Bash",
        "tier": "locked",
        "blocks": true,
        "checks": [
          "secrets-staged"
        ]
      }
    ]
  },
  "anchors": [
    {
      "id": "format-complexity",
      "file": "skills/kerby/rulebooks/swe/BOOTSTRAP.md",
      "quote": "complexity: <N> (trigger: <≤8-word reason>) → route: <investigate | new-project | adopt-existing | feature | bugfix | quick-task>"
    },
    {
      "id": "format-rung",
      "file": "skills/kerby/rulebooks/swe/BOOTSTRAP.md",
      "quote": "rung: <N> — <≤8-word reason>"
    },
    {
      "id": "format-plan",
      "file": "skills/kerby/rulebooks/swe/BOOTSTRAP.md",
      "quote": "plan: <files> — <change> — <check>"
    },
    {
      "id": "format-plan-waived",
      "file": "skills/kerby/rulebooks/swe/BOOTSTRAP.md",
      "quote": "plan: <files> — <change> — <check> (full plan waived: user opt-out \"<quoted phrase>\")"
    },
    {
      "id": "format-intent",
      "file": "skills/kerby/rulebooks/swe/references/intent-gate.md",
      "quote": "INTENT: code does <X>; the failing check/task expects <Y>; the spec (README/docs/docstring) says <Z>"
    },
    {
      "id": "format-skipped",
