---
// Shell for the swe guide pages: page nav, version stamp, pinned-source link.
// Everything numeric or versioned comes from swe.json; coverage() fails the
// build if swe.json names a hook, route or command the prose does not cover.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import swe from '../data/swe.json';
import { coverage } from '../data/swe-prose';
import { url } from '../lib/url';
import '../styles/guide.css';

coverage();

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const PAGES = [
  ['', 'Overview'],
  ['lifecycle/', 'Lifecycle'],
  ['workflows/', 'Workflows'],
  ['bug-walkthrough/', 'Bug walkthrough'],
  ['hooks/', 'Hooks'],
  ['reference/', 'Reference'],
] as const;

const strip = (p: string) => p.replace(/\/+$/, '');
const here = strip(Astro.url.pathname);
const source = `https://github.com/${swe.source_repo}/tree/${swe.source_sha}/skills/kerby/rulebooks/swe`;
---

<Base title={`${title} — swe rulebook — kerby`} description={description}>
  <SiteHeader mainId="guide-main" />
  <div class="guide-shell">
    <aside class="guide-rail">
      <p class="eyebrow">SWE / Field guide</p>
      <nav aria-label="SWE guide"><ul>
        {PAGES.map(([path, label]) => {
          const href = url(`rulebooks/swe/${path}`);
          return <li><a href={href} aria-current={strip(href) === here ? 'page' : undefined}>{label}</a></li>;
        })}
      </ul></nav>
      <p class="rail-note">Conditions.<br />Evidence.<br />The next step.</p>
      <a class="rail-source" href={source}>SWE {swe.version} ↗</a>
    </aside>
    <main id="guide-main" class="guide"><slot /></main>
  </div>

  <aside class="section stamp" aria-label="About this guide">
    <p>
      This guide describes <strong>swe {swe.version}</strong>, shipped in kerby {swe.kerby_version}. It is
      built from a pinned rulebook release. Versions, inventories and quoted formats are checked against
      that source; explanations are editorial, and illustrative examples are labeled.
    </p>
    <p>
      <a href={source}>Read the swe source at {swe.source_sha.slice(0, 7)}</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={url('rulebooks/swe/reference/#glossary')}>Glossary</a>
    </p>
  </aside>
  <Footer />
</Base>

<script src="../scripts/guide.js"></script>
